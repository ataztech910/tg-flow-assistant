# Copy to deploy.env, fill in real values, then:
#   deno deploy env load deploy.env --org=<org> --app=<app>
# deploy.env is gitignored — never commit real tokens.

PUBLIC_URL=https://your-app.your-org.deno.net
PROD_BOT_IDS=123456789
BOT_TOKEN_123456789=123456789:your-bot-token-from-botfather

# Optional — enables GET /admin/leads/<id> for exporting collected leads. Unset = route refuses
# outright (404), not left open. Generate with: openssl rand -hex 24
ADMIN_SECRET=
